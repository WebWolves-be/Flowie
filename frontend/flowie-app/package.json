{
  "name": "flowie-app",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build-info": "node scripts/generate-build-info.mjs",
    "start": "ng serve",
    "prebuild": "npm run build-info",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:desktop": "playwright test --project=desktop"
  },
  "dependencies": {
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "ngx-quill": "^31.0.1",
    "quill": "^2.0.3",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@playwright/test": "^1.58.2",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "sass": "^1.77.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.8.0"
  }
}
